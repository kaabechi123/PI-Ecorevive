{% extends 'base.html.twig' %}

{% block title %}Update Avatar{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center mb-4">Update Your Avatar</h1>

        <div class="row justify-content-center">
            <div class="col-md-6">
                {{ form_start(form, {'attr': {'class': 'form-group'}}) }}
                    <div class="mb-3">
                        <label for="avatarFile" class="form-label">Choose New Avatar</label>
                        {{ form_widget(form.avatarFile, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-primary btn-lg">Update Avatar</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        {% if user.avatar %}
            <hr class="my-4">
            <div class="row justify-content-center">
                <div class="col-md-6 text-center">
                    <h2 class="mb-3">Current Avatar</h2>
                    <img src="{{ asset('uploads/avatars/' ~ user.avatar) }}" alt="Avatar" class="img-fluid rounded-circle" style="max-width: 200px;">
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
